# Required API keys
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Optional model overrides
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_MODEL=gemini-2.5-flash

# Comma-separated origins allowed by CORS (Electron dev server by default)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Pending action expiry in seconds
PENDING_ACTION_TTL_SECONDS=300

# Installed app index cache TTL in seconds
APP_CACHE_TTL_SECONDS=300

# Terminal command timeouts (seconds)
TERMINAL_COMMAND_TIMEOUT=60
TERMINAL_LONG_COMMAND_TIMEOUT=600
